// Layer 2: the pipeline repo's config (nf-core layout)
params {
    outdir = 'results'
    marker = 'repo'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    demo {
        process {
            withName: 'MULTIQC' {
                ext.set_by = 'profile'
                ext.profile = 'y'
            }
        }
    }
}
