// nf-core style modules.config: withName by plain process name
process {
    withName: 'FASTQC' {
        time = '3h'
        ext.args = '--quiet'
        ext.set_by = 'modules_withName'
    }
    withName: 'SAMTOOLS_SORT' {
        ext.set_by = 'modules_withName'
        ext.prefix = 'sorted'
    }
}
