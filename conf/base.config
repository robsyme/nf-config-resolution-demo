// nf-core style base.config: top-level defaults and withLabel resources
process {
    cpus   = 1
    memory = 1.GB
    time   = '1h'

    withLabel: process_single {
        cpus = 1
        time = '2h'
    }
    withLabel: process_low {
        cpus   = 2
        memory = 1.GB
        time   = '2h'
        ext.set_by = 'base_withLabel'
    }
    withLabel: process_medium {
        cpus   = 2
        memory = 2.GB
        time   = '2h'
    }
    withLabel: process_high {
        cpus   = 2
        memory = 3.GB
        time   = '2h'
    }
}
