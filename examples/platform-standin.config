// Local stand-in for the nextflow.config Platform writes into the head job's
// launch directory on AWS Batch (order from AbstractComputePlatformProvider /
// AwsBatchPlatformProvider). Run from a directory holding this file as nextflow.config.
timeline.enabled = true
// ---- compute environment "Nextflow config" field, pasted inline ----
includeConfig 'CE_CONFIG'
// ---- lines Platform injects ----
process.executor = 'local'          // Platform: 'awsbatch'
process.queue = 'WORK_QUEUE'        // Platform: the CE's compute queue
workDir = 'work'
process.scratch = false             // Platform adds this when Fusion is on
// ---- user custom config (launchpad / launch form), included last ----
includeConfig 'LAUNCH_CONFIG'
