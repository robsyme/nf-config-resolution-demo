// Layer 4: the launchpad pipeline's "Nextflow config file" field.
// HEAD_QUEUE and WORK_QUEUE are the Forge queues of the demo CE.
params.marker = 'launchpad'

process {
    withName: 'CELLRANGER_MULTI' {
        label = 'process_large_ebs'
        time  = '6h'
        ext.set_by = 'launchpad_plain_name'
    }
    withName: '.*:SAMTOOLS_SORT' {
        time  = { 6.h * task.attempt }
        queue = { task.attempt < 3 ? 'WORK_QUEUE' : 'HEAD_QUEUE' }
        ext.set_by = 'launchpad_fqn_regex'
    }
}
