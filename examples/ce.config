// Layer 3: the compute environment's "Nextflow config" field.
// Platform fixes this text when the CE is created; it cannot be edited later.
params.marker = 'ce'

process {
    memory     = 2.GB
    maxRetries = 3

    // A top-level queue closure. AWS_BATCH_JQ_NAME is set by AWS Batch inside the
    // head job, so this names the Forge head queue without hard-coding the CE id.
    queue = { System.getenv('AWS_BATCH_JQ_NAME') }

    withName: '.*' {
        time = '5h'
        ext.set_by = 'ce_withName_all'
        ext.ce = 'y'
    }
    withLabel: process_high {
        memory = 3.GB
    }
    withLabel: process_large_ebs {
        queue = { System.getenv('AWS_BATCH_JQ_NAME') }
        ext.routed = 'large_ebs'
    }
}
